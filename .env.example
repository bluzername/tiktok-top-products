# ---------------------------------------------------------------------------
# Local development (direct mode)
# When VITE_APIFY_TOKEN is set, `npm run dev` calls Apify straight from the
# browser and skips the Vercel function. Every page load is a paid actor run
# (~2 minutes), so leave these unset unless you are debugging the scraper.
# ---------------------------------------------------------------------------
VITE_APIFY_TOKEN=
VITE_TIKTOK_COOKIES=
# Optional: override the actor used in direct mode
# VITE_APIFY_ACTOR_ID=doliz~tiktok-creative-center-scraper

# ---------------------------------------------------------------------------
# Vercel deployment
# Set these in Vercel: Project > Settings > Environment Variables.
# They are read by api/products.ts and api/refresh.ts only, never shipped
# to the browser.
# ---------------------------------------------------------------------------

# Apify API token: https://console.apify.com/account/integrations
APIFY_TOKEN=

# TikTok Creative Center session cookies, as one "name=value; name2=value2" string.
# HOW TO GET THEM: log in at https://ads.tiktok.com/business/creativecenter,
# open DevTools > Network, pick any request to ads.tiktok.com and copy the
# full value of the request "Cookie" header.
# THEY EXPIRE: TikTok sessions last days to a few weeks. When they expire the
# cron and /api/products start failing with a TikTok API error (the cached
# snapshot keeps serving). Paste fresh cookies here, redeploy or let the next
# cron run pick them up, then hit /api/refresh manually to verify.
TIKTOK_COOKIES=

# Shared secret for the cron endpoint. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" on scheduled runs; use the same header
# to trigger a refresh by hand:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<your-app>.vercel.app/api/refresh
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Vercel Blob read-write token. Create a Blob store in Vercel: Storage > Create >
# Blob, connect it to this project and the token is injected automatically.
# Without it the cache is in-memory only, which on Vercel means every cold
# start triggers a live Apify run.
BLOB_READ_WRITE_TOKEN=

# Optional overrides (defaults shown)
# APIFY_ACTOR_ID=doliz~tiktok-creative-center-scraper
# TOP_PRODUCTS_LIMIT=20
